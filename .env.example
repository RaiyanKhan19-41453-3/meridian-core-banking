# Copy to .env and replace every placeholder. NEVER commit .env.
POSTGRES_DB=corebanking
POSTGRES_USER=corebanking
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Generate with: openssl rand -base64 64
JWT_KEY=REPLACE_WITH_A_64_BYTE_RANDOM_KEY
Jwt__Issuer=core-banking
Jwt__Audience=core-banking-clients
# Generate with: openssl rand -base64 48
Security__EncryptionKey=REPLACE_WITH_A_RANDOM_ENCRYPTION_KEY

API_PORT=8090
FRONTEND_PORT=8091
POSTGRES_PORT=55432

# Production: strict rate limits (the dev compose overrides these for tests)
RateLimiting__AuthPermitLimit=10
RateLimiting__MoneyPermitLimit=30
RateLimiting__WindowMinutes=1

# Data retention (days; 2555 = 7 years)
Retention__AuditDays=2555
Retention__AmlAlertDays=2555

# TLS certificate paths (mounted into the frontend/nginx container)
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
PUBLIC_HOSTNAME=bank.example.com
